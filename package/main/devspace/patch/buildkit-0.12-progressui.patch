# Subject: Adapt DevSpace localregistry printer for buildkit 0.12 progressui API
#
# buildkit v0.12.5 changes progressui.DisplaySolveStatus to take a console.Console
# and io.Writer before the status channel:
# https://github.com/moby/buildkit/blob/v0.12.5/util/progress/progressui/display.go
#
# DHI modifications:
# - Drop the legacy empty phase string argument and pass nil console.
diff --git a/pkg/devspace/build/builder/localregistry/printer.go b/pkg/devspace/build/builder/localregistry/printer.go
--- a/pkg/devspace/build/builder/localregistry/printer.go
+++ b/pkg/devspace/build/builder/localregistry/printer.go
@@ -40,7 +40,7 @@ func NewPrinter(ctx context.Context, out io.Writer) (progresswriter.Writer, error
 	go func() {
 		// not using shared context to not disrupt display but let is finish reporting errors
-		_, pw.err = progressui.DisplaySolveStatus(ctx, "", nil, out, statusCh)
+		_, pw.err = progressui.DisplaySolveStatus(ctx, nil, out, statusCh)
 		close(doneCh)
 	}()
 	return pw, nil
 }
